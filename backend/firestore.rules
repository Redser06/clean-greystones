rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isApp(appId) {
      return appId == 'litter' || appId == 'roads';
    }

    // Town ids are allowlisted from data/towns. Rules cannot read that file.
    // Adding a town means adding it here.
    function isKnownTown(townId) {
      return townId == 'greystones';
    }

    function isTownAdmin(townId) {
      return signedIn()
        && request.auth.token.keys().hasAll(['admin'])
        && request.auth.token.admin is map
        && request.auth.token.admin.keys().hasAll(['towns'])
        && request.auth.token.admin.towns is list
        && townId in request.auth.token.admin.towns;
    }

    function scoped(data, mode, townId, appId) {
      return mode == 'prod'
        && isKnownTown(townId)
        && isApp(appId)
        && data.mode == mode
        && data.townId == townId
        && data.appId == appId;
    }

    function validReport(data, mode, townId, appId) {
      return scoped(data, mode, townId, appId)
        && data.is_seeded_demo == false
        && data.authorUid == request.auth.uid
        && data.lat is number
        && data.lat >= -90
        && data.lat <= 90
        && data.lng is number
        && data.lng >= -180
        && data.lng <= 180
        && data.severity in ['just_poop', 'stepped_in', 'buggy_wheels', 'wheelchair_wheels']
        && data.createdAt is timestamp
        && data.status in ['spotted', 'stale', 'pending', 'merged']
        && data.submitterToken is string
        && data.submitterToken.size() > 0
        && data.submitterToken.size() <= 64
        && (!('note' in data) || (data.note is string && data.note.size() <= 500))
        && data.keys().hasOnly([
          'mode', 'townId', 'appId', 'is_seeded_demo', 'authorUid', 'lat', 'lng',
          'severity', 'createdAt', 'status', 'submitterToken', 'note'
        ]);
    }

    function ratePath(mode, townId, appId) {
      return /databases/$(database)/documents/modes/$(mode)/towns/$(townId)/apps/$(appId)/rateLimits/$(request.auth.uid);
    }

    function rateShape(data, uid) {
      return data.uid == uid
        && data.count is int
        && data.windowStart is timestamp
        && data.lastReportId is string
        && data.lastReportId.size() > 0
        && data.lastReportId.size() <= 128
        && data.keys().hasOnly(['uid', 'count', 'windowStart', 'lastReportId']);
    }

    function ratedReport(mode, townId, appId) {
      return /databases/$(database)/documents/modes/$(mode)/towns/$(townId)/apps/$(appId)/reports/$(request.resource.data.lastReportId);
    }

    // One rate-doc step names exactly one report. A batch cannot share that step.
    function rateAllows(mode, townId, appId, reportId) {
      let path = ratePath(mode, townId, appId);
      let after = getAfter(path);
      let existed = exists(path);
      let fresh = !existed || request.time >= get(path).data.windowStart + duration.value(1, 'h');
      return mode == 'prod'
        && isKnownTown(townId)
        && isApp(appId)
        && rateShape(after.data, request.auth.uid)
        && after.data.lastReportId == reportId
        && (
          (fresh && after.data.count == 1 && after.data.windowStart == request.time)
          || (!fresh
            && after.data.count == get(path).data.count + 1
            && after.data.count <= 8
            && after.data.windowStart == get(path).data.windowStart)
        );
    }

    match /modes/{mode}/towns/{townId}/apps/{appId}/reports/{reportId} {
      allow read: if signedIn() && (
        resource.data.authorUid == request.auth.uid
        || isTownAdmin(townId)
      );
      allow create: if signedIn()
        && mode == 'prod'
        && validReport(request.resource.data, mode, townId, appId)
        && rateAllows(mode, townId, appId, reportId);
      allow update, delete: if false;
    }

    match /modes/{mode}/towns/{townId}/apps/{appId}/aggregates/{aggregateId} {
      allow read: if isTownAdmin(townId);
      allow write: if false;
    }

    match /modes/{mode}/towns/{townId}/apps/{appId}/rateLimits/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && mode == 'prod'
        && isKnownTown(townId)
        && isApp(appId)
        && request.auth.uid == uid
        && rateShape(request.resource.data, uid)
        && request.resource.data.count == 1
        && request.resource.data.windowStart == request.time
        && existsAfter(ratedReport(mode, townId, appId));
      allow update: if signedIn()
        && mode == 'prod'
        && isKnownTown(townId)
        && isApp(appId)
        && request.auth.uid == uid
        && rateShape(request.resource.data, uid)
        && rateShape(resource.data, uid)
        && existsAfter(ratedReport(mode, townId, appId))
        && (
          (
            request.resource.data.count == resource.data.count + 1
            && request.resource.data.count <= 8
            && request.resource.data.windowStart == resource.data.windowStart
          )
          || (
            request.time >= resource.data.windowStart + duration.value(1, 'h')
            && request.resource.data.count == 1
            && request.resource.data.windowStart == request.time
          )
        );
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
