# Which file in data/towns/ to load, without .json. Blank uses greystones.
VITE_TOWN=

# Baked in by Vite at build time. Never commit a real key.
# When this is empty, the map uses OpenStreetMap instead of Google Streets.
VITE_GOOGLE_MAPS_API_KEY=

# Set to true only for a local demo. Leave unset for production builds.
VITE_DEMO_DATA=
