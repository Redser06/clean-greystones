# Which file in data/towns/ to load, without .json. Blank uses greystones.
VITE_TOWN=

# Baked in by Vite at build time. Never commit a real key.
VITE_GOOGLE_MAPS_API_KEY=

# Demo mode. Off unless this is exactly true. Production builds refuse true.
VITE_DEMO=

# Firebase web config. Public client config only. Leave blank until Conor fills it.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
